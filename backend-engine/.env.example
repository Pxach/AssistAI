PORT=5000
NODE_ENV=development

# --- AI PROVIDER KEYS ---
GEMINI_API_KEY=your_gemini_key_here
GROK_API_KEY=your_grok_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
MISTRAL_API_KEY=your_mistral_key_here

GROK_BASE_URL=https://api.xai.com/v1
OPENROUTER_SITE_URL=http://localhost:5000
OPENROUTER_SITE_NAME=AssistAI

# --- GOOGLE CALENDAR CONFIGURATION ---
# calendarService.js reads these via configService.getConfig() at call time.
# When the dashboard DB is ready, remove these and let getConfig() fetch from the DB instead.
CALENDAR_ID=your_google_calendar_id@group.calendar.google.com
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- FEEDBACK & REVIEW URLS ---
# feedbackHandler.js reads these via configService.getConfig() at call time.
# Replace with real URLs before going to production.
GOOGLE_REVIEW_URL=https://g.page/r/YOUR_GOOGLE_REVIEW_LINK
TALLY_FORM_URL=https://tally.so/r/YOUR_TALLY_FORM_ID

# --- DATABASE CONFIGURATION ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=assist_ai_db

# --- DASHBOARD BACKEND ---
# sessionSyncService.js fires HTTP PATCH to: {DASHBOARD_API_URL}/api/whatsapp/session-status
DASHBOARD_API_URL=http://localhost:3001