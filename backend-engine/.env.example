# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# AI PROVIDER CONFIGURATION
# ==========================================
# llmClient.js auto-detects active providers at call time by scanning for
# non-empty API keys below. Providers are tried in this exact order on failure.
# To disable a provider, leave its API key blank — it will be silently skipped.

# 1. Gemini (Primary — Google)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL="gemini-3.5-flash-lite"

# 2. Groq (Secondary — fallback)
GROQ_API_KEY=your_groq_api_key_here

# 3. Mistral AI (Tertiary — fallback)
MISTRAL_API_KEY=""
MISTRAL_MODEL=open-mistral-nemo

# 4. Nvidia NIM (Quaternary — fallback)
NVIDIA_API_KEY=""
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# 5. OpenRouter (Fallback Aggregator — routes to hundreds of models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_SITE_URL=http://localhost:5000
OPENROUTER_SITE_NAME=AssistAI
OPENROUTER_MODEL=google/gemma-2-9b-it:free

# ==========================================
# GOOGLE CALENDAR CONFIGURATION
# ==========================================
# Service Account & Calendar details (read via configService.getConfig())
# When the dashboard DB is ready, these move to the config table.
CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# ==========================================
# FEEDBACK & REVIEW URLS
# ==========================================
# Dispatched post-appointment based on user rating (feedbackHandler.js)
GOOGLE_REVIEW_URL=https://g.page/r/YOUR_GOOGLE_REVIEW_LINK
TALLY_FORM_URL=https://tally.so/r/YOUR_TALLY_FORM_ID

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
# Prepared for ORM/database integration — swap configService internals when ready.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=assist_ai_db

# ==========================================
# DASHBOARD INTERACTION
# ==========================================
# sessionSyncService.js fires HTTP PATCH to: {DASHBOARD_API_URL}/api/whatsapp/session-status
# No trailing slash.
DASHBOARD_API_URL=http://localhost:3001

# ==========================================
# WHATSAPP GATEWAY CONFIGURATION
# ==========================================
# JID of the admin/manager who receives escalation alerts.
# Format: <country_code><phone_number>@s.whatsapp.net
# Example: 212600000000@s.whatsapp.net
WA_ADMIN_JID=your_admin_whatsapp_jid_here

# NODE_ENV controls the dev-only message whitelist.
# Set to 'production' to allow all messages through (no whitelist restriction).
# Values: development | production
NODE_ENV=development